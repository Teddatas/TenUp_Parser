# Configuration TenUp Parser - GRATUIT (100%)

# Adresse de départ pour le calcul des trajets
# Exemple: "Paris, France" ou "75012 Paris" ou "156 rue de la Nouvelle France, Montreuil"
DEPARTURE_ADDRESS=Paris, France

# Mode de transport par défaut
# Options: driving (voiture), walking (à pied), cycling (vélo), transit (métro/bus)
TRANSPORT_MODE=driving

# ========================================
# API NAVITIA - Transports en commun
# ========================================

# Clé API Navitia (optionnel - pour trajets en métro/bus/RER)
# Gratuit : s'inscrire sur https://www.navitia.io/
# En quelques minutes, vraiment simple !
# Si non configuré, le mode transit utilisera OSRM comme fallback
NAVITIA_API_KEY=

# NOTE: Google Maps n'est pas utilisé car il est payant
# OSRM (Open Source Routing Machine) est gratuit et utilisé par défaut


# ======================================================================
# CARTE DES TOURNOIS  (main_carte.py — branche feat/carte-tournois)
# ======================================================================

# Adresse de départ (géocodée via la Base Adresse Nationale, gratuit sans clé).
# Si le géocodage échoue, renseigner directement les coordonnées.
DEPARTURE_ADDRESS=12 rue Example, 75000 Paris
# DEPARTURE_LAT=48.858413
# DEPARTURE_LNG=2.378127

# Étendue de la recherche (sexe / simple-double / âge / classement se filtrent
# ensuite EN DIRECT dans la carte)
SEARCH_RADIUS_KM=30
SEARCH_WINDOW_DAYS=120

# Temps de trajet hors-ligne (r5py) — fichiers dans data/r5/ (scripts/download_r5_data.sh)
R5_DEPARTURE_WEEKDAY=5       # 0=lundi … 5=samedi (créneau représentatif)
R5_DEPARTURE_TIME=10:00
R5_MAX_TRIP_MINUTES=150
R5_SPEED_CYCLING_KMH=16
R5_SPEED_WALKING_KMH=4.8

